# Keep this file safe to commit: it must never contain a live API key.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
# Protect an 8K TPM Groq account. The application reserves at most 7K tokens per rolling minute.
GROQ_WINDOW_TOKEN_BUDGET=7000
GROQ_MAX_INPUT_CHARS=18000
GROQ_ANSWER_MAX_TOKENS=500
GROQ_MEMORY_MAX_TOKENS=180
# Embeddings used for Atlas Vector Search. Create this key at Voyage AI; never commit it.
VOYAGE_API_KEY=replace_with_your_voyage_key
VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024
MONGODB_VECTOR_INDEX=memory_vector_index
# Paste the MongoDB Atlas "Drivers > Python" connection string here.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/agentic_memory?retryWrites=true&w=majority
MONGODB_DATABASE=agentic_memory
ALLOWED_ORIGIN=http://localhost:5173
