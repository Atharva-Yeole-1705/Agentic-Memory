# Keep this file safe to commit: it must never contain a live API key.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
# Paste the MongoDB Atlas "Drivers > Python" connection string here.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/agentic_memory?retryWrites=true&w=majority
MONGODB_DATABASE=agentic_memory
ALLOWED_ORIGIN=http://localhost:5173
